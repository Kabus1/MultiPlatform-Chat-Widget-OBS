# Turns every file in WEB_DIR into a byte array inside a generated C++ source,
# so the dock UI ships inside the single executable.
file(GLOB ASSETS RELATIVE ${WEB_DIR} ${WEB_DIR}/*)
list(SORT ASSETS)

set(BODY "// Generated by cmake/EmbedAssets.cmake - do not edit.\n#include \"server/EmbeddedAssets.hpp\"\n\nnamespace usc::assets {\nnamespace {\n")
set(TABLE "")
set(INDEX 0)
foreach(NAME ${ASSETS})
  file(READ ${WEB_DIR}/${NAME} HEX HEX)
  string(LENGTH "${HEX}" HEXLEN)
  math(EXPR SIZE "${HEXLEN} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," HEX "${HEX}")
  string(APPEND BODY "const unsigned char kData${INDEX}[] = {${HEX}0x00};\n")
  string(APPEND TABLE "    {\"/${NAME}\", kData${INDEX}, ${SIZE}},\n")
  math(EXPR INDEX "${INDEX} + 1")
endforeach()
string(APPEND BODY "} // namespace\n\nconst std::vector<Asset>& all() {\n  static const std::vector<Asset> kAssets = {\n${TABLE}  };\n  return kAssets;\n}\n\n} // namespace usc::assets\n")
file(WRITE ${OUT}.tmp "${BODY}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
